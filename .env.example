# OpsPilot — environment template
# Copy to .env and fill in local values. Do not commit .env.
#
# Used by:
# - Docker Compose (variable interpolation + service environment)
# - Local Go / local Agent (V1 Demo: Agent 在宿主机跑，见 docs/DEMO.md §1)
#
# Priority for the Go backend: process env > OpsPilot/.env > code defaults.
# Compose injects env into containers; do not bake .env into images.
#
# V1 Demo 必填（留空则 Chat 或知识检索失败，无 mock）：
#   LLM_API_KEY
#   SILICONFLOW_API_KEY
# 详细步骤：docs/DEMO.md

# --- PostgreSQL ---
# Business DB (Go Backend only): opspilot
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot
POSTGRES_DB=opspilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://opspilot:opspilot@postgres:5432/opspilot?sslmode=disable

# --- Go Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
JWT_SECRET=change-me-in-local-dev
JWT_EXPIRE_HOURS=24

# --- Agent runtime (FastAPI) ---
AGENT_HOST=0.0.0.0
AGENT_PORT=8000
AGENT_LOG_LEVEL=INFO
# Compose 内 Agent→Go 用下面主机名。V1 Demo 官方路径是本机 uvicorn，
# 启动前覆盖为 http://localhost:8080（见 docs/DEMO.md §1.4）。
BUSINESS_API_BASE_URL=http://backend:8080
# Must match Go Backend JWT_SECRET (Agent verifies user Bearer tokens).
# JWT_SECRET is defined in the Go Backend section above — Compose injects the same value.
# AGENT_SYSTEM_USERNAME / AGENT_SYSTEM_PASSWORD removed (Phase 8.1):
# business Tools use caller JWT only; do not reintroduce system-account login.

# Phase 11.1 — Agent Checkpoint DB (LangGraph state + thread ownership only).
# Isolated DB opspilot_agent; Agent must NOT use DATABASE_URL / business schema.
# 本机 Agent 把 @postgres: 换成 @localhost:5432。
CHECKPOINT_BACKEND=postgres
CHECKPOINT_DATABASE_URL=postgres://opspilot:opspilot@postgres:5432/opspilot_agent?sslmode=disable

# --- LLM Provider (OpenAI-compatible; DeepSeek for Agent V1) ---
# Demo 必填。Missing key → HTTP 503, no Tool calls, no mock path.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# --- LangSmith tracing (optional; langchain auto-reads these if set) ---
# Not required for Agent V1 chat / tool-calling. Enable when debugging traces.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=opspilot-agent
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- Knowledge (C-3：load → chunk → index → search_knowledge) ---
# Demo 必填 SILICONFLOW_API_KEY：离线 index 与运行时 query embedding 都用。
# 不要用 python -m app.rag.ingest（遗留本地 npy）。
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
EMBED_MODEL_NAME=BAAI/bge-m3
EMBED_DIM=1024
MILVUS_URI=http://127.0.0.1:19530
# Active Milvus collection for index + search_knowledge (default: knowledge_docs).
# Use a separate name (e.g. knowledge_docs_dayi) for isolated corpora.
# Dropping/rebuilding knowledge_docs requires: python -m app.rag.index --allow-drop-default-collection
MILVUS_COLLECTION=knowledge_docs
